<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="160dp"
    android:layout_height="140dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Head status pill: centered horizontally above the avatar -->
    <TextView
        android:id="@+id/bubble_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:background="@drawable/state_pill_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#3D2D18"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxWidth="150dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:elevation="3dp"
        android:visibility="gone" />

    <!-- Avatar: fixed size 100dp x 100dp, centered horizontally, below top space -->
    <ai.axiomaster.bonio.avatar.PixelAvatarView
        android:id="@+id/pixel_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="36dp" />

</RelativeLayout>
