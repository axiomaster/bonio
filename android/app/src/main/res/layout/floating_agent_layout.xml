<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <androidx.cardview.widget.CardView
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:contentPaddingLeft="8dp"
        app:contentPaddingRight="8dp"
        app:contentPaddingTop="4dp"
        app:contentPaddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/bubble_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3D2D18"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/text_bubble_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/text_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:textColor="#3D2D18"
                    android:textSize="13sp" />

            </ScrollView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <ai.axiomaster.bonio.avatar.PixelAvatarView
        android:id="@+id/pixel_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp" />

</LinearLayout>
